# Postgres. Required on Vercel. Omit locally to use data/pglite.
DATABASE_URL=

# Load the sample workspace on an empty database. Set false in production.
SEED_DEMO=true

# Public origin used for Stripe return URLs and the OBS link. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe. Leave unset locally to allow a simulated payment outside production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set true only when creators have Stripe Connect accounts (acct_…).
# Otherwise payouts are recorded manually.
STRIPE_CONNECT=false

# Supabase Storage. Both values are server-only. Never prefix the service role with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=creatives

# Twitch OAuth. Without these, an administrator verifies channels.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Bearer token for GET or POST /api/cron/tick.
CRON_SECRET=
